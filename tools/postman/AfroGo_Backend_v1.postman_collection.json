          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
        },
        {
          "name": "ReconcilePendingPayments",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/billing/reconcile-pending", "host": ["{{baseUrl}}"], "path": ["billing", "reconcile-pending"] },
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Ops / Variance Review",
      "item": [
        {
          "name": "ListPendingPayouts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/ops/payouts/pending-review?limit=50", "host": ["{{baseUrl}}"], "path": ["ops", "payouts", "pending-review"], "query": [{ "key": "limit", "value": "50" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
        },
        {
          "name": "ApprovePayout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/ops/payouts/{{payoutId}}/approve", "host": ["{{baseUrl}}"], "path": ["ops", "payouts", "{{payoutId}}", "approve"] },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"UAT variance verified, approve.\",\n  \"approver\": \"abel.cto@afrogo.co.za\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
        },
        {
          "name": "TopupPayout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/ops/payouts/{{payoutId}}/topup", "host": ["{{baseUrl}}"], "path": ["ops", "payouts", "{{payoutId}}", "topup"] },
            "body": { "mode": "raw", "raw": "{\n  \"topupAmount\": 75.00,\n  \"note\": \"Exceptional traffic delay\",\n  \"approver\": \"abel.cto@afrogo.co.za\",\n  \"idempotencyKey\": \"UAT-TOPUP-{{payoutId}}\"\n}" }
