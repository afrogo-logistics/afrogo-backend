// ============================================================================
// UPDATE DRIVER METRICS
// ============================================================================

async function updateDriverMetrics(driverId: string, data: any) {
  if (! driverId) return;

  await ddb.send(
    new UpdateItemCommand({
      TableName: 'Drivers',
      Key: { PK: { S: driverId }, SK: { S: 'METADATA' } },
      UpdateExpression: `
        SET stats = :stats
      `,
      ExpressionAttributeValues: {
        ':stats': {
          S: JSON.stringify({
            routesCompleted: (data.routesCompleted || 0) + 1,
            totalDeliveries: (data.totalDeliveries || 0) + (data.deliveryCount || 0),
            onTimeRate: data.onTime ? 100 : 0,
            customerRating: data.rating || 5,
          }),
        },
      },
    }),
  );
}

