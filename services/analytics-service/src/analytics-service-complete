const ddb = new DynamoDBClient({});

// ============================================================================
// ANALYTICS EVENT PROCESSOR
// ============================================================================

export const processAnalyticsEvent: SQSHandler = async (event) => {
  for (const record of event.Records) {
    try {
      const analyticsEvent = JSON.parse(record.body);
      await recordAnalytics(analyticsEvent);
    } catch (error) {
      console.error('Analytics processing error:', error);
    }
  }
};

// ============================================================================
// RECORD ANALYTICS
// ============================================================================

async function recordAnalytics(event: any) {
  const { eventType, merchantId, driverId, parcelId, timestamp, data } = event;

  const date = new Date(timestamp).toISOString().split('T')[0];
  const hour = new Date(timestamp).getHours();

  // Store hourly metric
  await ddb.send(
    new PutItemCommand({
      TableName: 'Analytics',
      Item: {
        PK: { S: merchantId || 'SYSTEM' },
        SK: { S: `${eventType}#${date}#${hour}` },
        eventType: { S: eventType },
        timestamp: { S: timestamp },
        data: { S: JSON.stringify(data) },
      },
    }),
  );

  // Update daily summary
  await updateDailySummary(merchantId, date, eventType, data);
  await updateDriverMetrics(driverId, data);
}

