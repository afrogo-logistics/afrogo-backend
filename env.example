# AfroGo Backend - environment example
# Copy to .env (do NOT commit real secrets)

# AWS / Region
REGION=af-south-1
AWS_REGION=af-south-1

# API
API_BASE_URL=https://api-dev.afrogo.co.za
API_VERSION=/v1                # used as the stable API prefix in Gateway (lock to /v1)

# DynamoDB table names
INVOICES_TABLE_NAME=Invoices
PARCELS_TABLE_NAME=Parcels
ROUTES_TABLE_NAME=Routes
DRIVER_PAYOUTS_TABLE=driver_payouts
AUDIT_TABLE_NAME=PayoutAuditLog

# S3
INVOICES_BUCKET=afrogo-invoices

# Secrets Manager ARNs
PG_SECRET_ARN=arn:aws:secretsmanager:...:secret:pg/afrogo/dev
PAYMENT_PROVIDER_SECRET_ARN=arn:aws:secretsmanager:...:secret:payment/provider/webhook
PAYMENT_PROVIDER_POLL_SECRET_ARN=arn:aws:secretsmanager:...:secret:payment/provider/poll
FCM_SECRET_ARN=arn:aws:secretsmanager:...:secret:fcm/keys

# Postgres pool tuning & retries
PG_MAX_CLIENTS=10
PG_MAX_RETRIES=2

# Optional 3rd-party / infra config
SES_SOURCE_EMAIL=billing@afrogo.co.za
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/MyQueue
SNS_TOPIC_ARN=arn:aws:sns:...

# Local dev helper (only used by local fixtures runner)
AUTH_TOKEN=           # if your API requires bearer token for UAT calls