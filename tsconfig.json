{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@afrogo/rate-engine-core": ["services/rate-engine/src/engine-domain.ts"],
      "@afrogo/rate-engine-core/*": ["services/rate-engine/src/*"]
      ,
      "@afrogo/shared-types": ["packages/shared-types/src/index.ts"],
      "@afrogo/shared-types/*": ["packages/shared-types/src/*"]
      ,
      "@afrogo/shared-ledger": ["packages/shared-ledger/src/index.ts"],
      "@afrogo/shared-ledger/*": ["packages/shared-ledger/src/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "services/**/*.ts",
    "lib/**/*.ts",
    "types/**/*",
    "tools/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
