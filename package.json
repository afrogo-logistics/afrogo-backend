{
  "name": "afrogo-headless-wargames",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
  "lint": "eslint \"services/**/src/**/*.ts\" \"lib/**/*.ts\" --ext .ts",
  "lint:fix": "eslint \"services/**/src/**/*.ts\" \"lib/**/*.ts\" --ext .ts --fix",
  "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
  "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
  "test": "node services/billing-service/tests/run-tests.cjs",
  "build:types": "npm -w @afrogo/shared-types run build",
  "build:packages": "npm -w @afrogo/shared-types run build && npm -w @afrogo/shared-ledger run build",
  "ci": "npm run build:packages && npm run lint && npm run typecheck && npm test",
    "test:headless-wargames": "newman run tools/postman/AfroGo_Backend_v1.postman_collection.json -e tools/postman/afrogo-dev.postman_environment.json --reporters cli",
    "fixtures:load": "node tools/load-fixtures.js"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.114",
    "@types/node": "^18.16.19",
    "@types/pg": "^8.6.6",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.30.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.956.0",
    "@aws-sdk/client-dynamodb": "^3.956.0",
    "@aws-sdk/client-secrets-manager": "^3.956.0",
    "dotenv": "^16.0.0",
    "newman": "^5.3.0",
    "node-fetch": "^2.6.7",
    "axios": "^1.4.0",
    "pg": "^8.11.0"
  }
}
